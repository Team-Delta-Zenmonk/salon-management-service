{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "templates/**",
          "public/**",
          "node_modules/react/**",
          "node_modules/react-dom/**",
          "node_modules/@react-email/**",
          "node_modules/pdfkit/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ]
}